# Conexão com o PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/mavi

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# Senha inicial das usuárias criadas pelo seed (troque após o primeiro login)
SEED_PASSWORD=mavi1234

# --- WhatsApp (fase 2) ---
# "log" = só registra (teste). "twilio" = envia de verdade.
WHATSAPP_PROVIDER=log
# Endereço público do sistema, usado no link de remarcar/cancelar (no Render é preenchido sozinho).
APP_URL=
# Segredo do agendador externo que chama /api/cron/messages (mínimo 16 caracteres).
CRON_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remetente habilitado para WhatsApp, ex.: +5561999999999
TWILIO_WHATSAPP_FROM=
# Modelos aprovados (obrigatórios para falar fora da janela de 24h). Opcional no sandbox.
TWILIO_CONTENT_SID_CONFIRMATION=
TWILIO_CONTENT_SID_REMINDER=
TWILIO_CONTENT_SID_BIRTHDAY=
