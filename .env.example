# Conexão com o PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/mavi

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# Senha inicial das usuárias criadas pelo seed (troque após o primeiro login)
SEED_PASSWORD=mavi1234
